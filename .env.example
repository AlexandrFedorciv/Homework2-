# Copy to .env and fill in. .env is git-ignored, never commit it.

# anthropic | openai (any OpenAI-compatible API) | mock (offline, no key)
LLM_PROVIDER=anthropic

# Anthropic. Leave LLM_MODEL empty for claude-opus-5-5.
# ANTHROPIC_API_KEY=

# OpenAI-compatible, LLM_MODEL is required:
#   Groq (free): OPENAI_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
#   Ollama (local, no key): OPENAI_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen3:8b
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# LLM_MODEL=
